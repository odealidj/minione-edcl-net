{
  "Logging": { "LogLevel": { "Default": "Information" } },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "edcl-api",
    "Audience": "edcl-mobile",
    "AccessTokenSecret": "CHANGE-ME-TO-A-VERY-LONG-SECRET-AT-LEAST-256-BITS"
  },
  "Serilog": {
    "MinimumLevel": { "Default": "Information" },
    "WriteTo": [{ "Name": "Console" }],
    "Properties": { "Application": "EDCL-Gateway" }
  },
  "ReverseProxy": {
    "Routes": {
      "health-route": {
        "ClusterId": "edcl-api-cluster",
        "AuthorizationPolicy": "anonymous",
        "Match": { "Path": "/health" }
      },
      "metrics-route": {
        "ClusterId": "edcl-api-cluster",
        "AuthorizationPolicy": "anonymous",
        "Match": { "Path": "/metrics" }
      },
      "swagger-route": {
        "ClusterId": "edcl-api-cluster",
        "AuthorizationPolicy": "anonymous",
        "Match": { "Path": "/swagger/{**catch-all}" }
      },
      "hangfire-route": {
        "ClusterId": "edcl-api-cluster",
        "AuthorizationPolicy": "anonymous",
        "Match": { "Path": "/hangfire/{**catch-all}" }
      },
      "openapi-route": {
        "ClusterId": "edcl-api-cluster",
        "AuthorizationPolicy": "anonymous",
        "Match": { "Path": "/openapi/{**catch-all}" }
      },
      "scalar-route": {
        "ClusterId": "edcl-api-cluster",
        "AuthorizationPolicy": "anonymous",
        "Match": { "Path": "/scalar/{**catch-all}" }
      },
      "auth-route": {
        "ClusterId": "edcl-api-cluster",
        "AuthorizationPolicy": "anonymous",
        "Match": { "Path": "/api/v1/auth/{**catch-all}" }
      },
      "web-route": {
        "ClusterId": "edcl-api-cluster",
        "AuthorizationPolicy": "anonymous",
        "Match": { "Path": "/api/v1/web/{**catch-all}" }
      },
      "admin-route": {
        "ClusterId": "edcl-api-cluster",
        "AuthorizationPolicy": "default",
        "Match": { "Path": "/api/v1/admin/{**catch-all}" }
      },
      "jobs-route": {
        "ClusterId": "edcl-api-cluster",
        "AuthorizationPolicy": "default",
        "Match": { "Path": "/api/v1/jobs/{**catch-all}" }
      },
      "manifests-route": {
        "ClusterId": "edcl-api-cluster",
        "AuthorizationPolicy": "default",
        "Match": { "Path": "/api/v1/manifests/{**catch-all}" }
      },
      "notifications-route": {
        "ClusterId": "edcl-api-cluster",
        "AuthorizationPolicy": "default",
        "Match": { "Path": "/api/v1/notifications/{**catch-all}" }
      },
      "bff-route": {
        "ClusterId": "edcl-api-cluster",
        "AuthorizationPolicy": "default",
        "Match": { "Path": "/api/v1/bff/{**catch-all}" }
      }
    },
    "Clusters": {
      "edcl-api-cluster": {
        "Destinations": {
          "edcl-api": { "Address": "http://localhost:5140/" }
        },
        "HealthCheck": {
          "Active": {
            "Enabled": true,
            "Interval": "00:00:10",
            "Timeout": "00:00:05",
            "Path": "/health"
          }
        }
      }
    }
  }
}
