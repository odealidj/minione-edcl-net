{
  "Logging": { "LogLevel": { "Default": "Warning" } },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "EdclDb": "Server=localhost;Database=edcl;User Id=sa;Password=P@ssw0rd;TrustServerCertificate=true;Encrypt=false;",
    "IdcsDb": "Server=localhost;Database=idcs;User Id=sa;Password=P@ssw0rd;TrustServerCertificate=true;Encrypt=false;"
  },
  "Jwt": {
    "Issuer": "edcl-api",
    "Audience": "edcl-mobile",
    "AccessTokenSecret": "CHANGE-ME-TO-A-VERY-LONG-SECRET-AT-LEAST-256-BITS",
    "AccessTokenExpiryMinutes": "15",
    "RefreshTokenExpiryDays": "30"
  },
  "Redis": {
    "MasterName": "edcl-master",
    "SentinelEndpoints": [ "localhost:26379", "localhost:26380", "localhost:26381" ],
    "Password": "",
    "ConnectTimeout": "5000",
    "SyncTimeout": "5000",
    "DefaultTtlMinutes": "60"
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": { "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {TraceId} {Message:lj}{NewLine}{Exception}" }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/edcl-api-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 7
        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithThreadId", "WithEnvironmentName" ],
    "Properties": { "Application": "EDCL-Api" }
  }
}
